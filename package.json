{
  "name": "match4good",
  "version": "1.0 - Official Beta Release",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:deploy": "npx prisma migrate deploy && npx prisma generate",
    "test": "jest",
    "prepare": "husky",
    "docs": "typedoc",
    "docs:watch": "nodemon",
    "docs:serve": "serve docs -l 5000",
    "seed:full": "cross-env SEED_MODE=full npx prisma db seed",
    "seed:minimal": "cross-env SEED_MODE=minimal npx prisma db seed",
    "start:dev:full": "cross-env SEED_MODE=full npx prisma migrate reset --force && npm run dev",
    "start:dev:minimal": "cross-env SEED_MODE=minimal npx prisma migrate reset --force && npm run dev"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@auth0/nextjs-auth0": "^4.5.1",
    "@hookform/resolvers": "^5.0.1",
    "@imagekit/next": "^2.1.2",
    "@mdx-js/loader": "^3.1.0",
    "@mdx-js/react": "^3.1.0",
    "@next/mdx": "^15.3.2",
    "@prisma/client": "^6.7.0",
    "@radix-ui/react-aspect-ratio": "^1.1.6",
    "@radix-ui/react-avatar": "^1.1.9",
    "@radix-ui/react-dialog": "^1.1.13",
    "@radix-ui/react-dropdown-menu": "^2.1.14",
    "@radix-ui/react-label": "^2.1.6",
    "@radix-ui/react-navigation-menu": "^1.2.12",
    "@radix-ui/react-progress": "^1.1.6",
    "@radix-ui/react-select": "^2.2.4",
    "@radix-ui/react-separator": "^1.1.6",
    "@radix-ui/react-slot": "^1.2.2",
    "@radix-ui/react-tabs": "^1.1.11",
    "@radix-ui/themes": "^3.2.1",
    "@tabler/icons-react": "^3.31.0",
    "@types/mdx": "^2.0.13",
    "auth0": "^4.23.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "dotenv": "^16.5.0",
    "imagekit": "^6.0.0",
    "imagekit-javascript": "^4.0.1",
    "imagekitio-react": "^4.3.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.510.0",
    "next": "^15.3.2",
    "next-themes": "^0.4.6",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-hook-form": "^7.56.3",
    "react-leaflet": "^5.0.0",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "sonner": "^2.0.3",
    "tailwind-merge": "^3.3.0",
    "tw-animate-css": "^1.2.9",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@faker-js/faker": "^9.7.0",
    "@tailwindcss/postcss": "^4.1.6",
    "@tailwindcss/typography": "^0.5.16",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/jest": "^29.5.14",
    "@types/leaflet": "^1.9.17",
    "@types/node": "^22.15.17",
    "@types/react": "^19.1.3",
    "@types/react-dom": "^19.1.4",
    "@types/uuid": "^10.0.0",
    "autoprefixer": "^10.4.21",
    "cross-env": "^7.0.3",
    "eslint": "^9.26.0",
    "eslint-config-next": "^15.3.2",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-jsdoc": "^50.6.14",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "lightningcss": "^1.30.0",
    "lint-staged": "^16.0.0",
    "nodemon": "^3.1.10",
    "postcss": "^8.5.3",
    "prettier": "^3.5.3",
    "prisma": "^6.7.0",
    "serve": "^14.2.4",
    "tailwindcss": "^4.1.6",
    "ts-jest": "^29.3.2",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.4",
    "typedoc": "^0.28.4",
    "typescript": "^5",
    "typescript-eslint": "^8.32.1",
    "uuid": "^11.1.0"
  },
  "lint-staged": {
    "*.{js,ts,tsx}": "eslint --cache --fix",
    "*.{js,ts,tsx,css,md,json}": "prettier --write"
  }
}
