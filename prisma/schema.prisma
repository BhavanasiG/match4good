generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma_client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id       Int     @id @default(autoincrement())
  userId  String  @unique
  username String  @unique
  email    String? @unique
  bio      String?

  ownerOf  Organization[] @relation("ownership")
  memberOf Organization[] @relation("membership")

  application Application[]

  region    Region? @relation(fields: [regionId], references: [id])
  regionId Int?
}

model Organization {
  id          Int       @id @default(autoincrement())
  name        String    @unique
  description String?
  ownerId    Int
  address     String?
  postcode    String?
  listings    Listing[]
  owner       User      @relation("ownership", fields: [ownerId], references: [id])
  members     User[]    @relation("membership")
}

enum ApplicationStatus {
  PENDING
  ACCEPTED
  REJECTED
}

model Application {
  id          Int               @id @default(autoincrement())
  description String?
  status      ApplicationStatus @default(PENDING)

  listing    Listing @relation(fields: [listingId], references: [id])
  user       User    @relation(fields: [userId], references: [id])
  listingId Int     @map("listingId")
  userId    Int     @map("userId")
}

model Listing {
  id             Int           @id @default(autoincrement())
  name           String
  description    String?
  startDatetime DateTime
  endDatetime   DateTime
  status         ListingStatus @default(acceptingApplications)
  pointValue    Int           @default(0)
  scored         Boolean       @default(false)

  organization    Organization @relation(fields: [organizationId], references: [id])
  organizationId Int

  applications Application[]
}

enum ListingStatus {
  acceptingApplications
  applicationsClosed
  completed
  cancelled
}

model Region {
  id     Int    @id @default(autoincrement())
  name   String
  points Int    @default(0)

  users User[]
}
