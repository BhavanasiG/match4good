generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma_client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          Int            @id @default(autoincrement())
  user_id     String         @unique
  username    String         @unique
  email       String?        @unique
  region_id   Int?
  bio         String?
  application Application[]
  Follow      Follow[]
  owner_of    Organization[] @relation("ownership")
  Region      Region?        @relation(fields: [region_id], references: [id])
  member_of   Organization[] @relation("membership")
}

model Organization {
  id          Int       @id @default(autoincrement())
  name        String    @unique
  description String?
  owner_id    Int
  address     String?
  postcode    String?
  followers   Follow[]
  listings    Listing[]
  owner       User      @relation("ownership", fields: [owner_id], references: [id])
  members     User[]    @relation("membership")
}

model Follow {
  id             Int          @id @default(autoincrement())
  userId         Int
  organizationId Int
  organization   Organization @relation(fields: [organizationId], references: [id])
  user           User         @relation(fields: [userId], references: [id])

  @@unique([userId, organizationId])
}

model Application {
  id          Int               @id @default(autoincrement())
  listing_id  Int               @map("listingId")
  user_id     Int               @map("userId")
  description String?
  status      ApplicationStatus @default(PENDING)
  listing     Listing           @relation(fields: [listing_id], references: [id])
  user        User              @relation(fields: [user_id], references: [id])
}

model Listing {
  id              Int           @id @default(autoincrement())
  name            String
  description     String?
  organization_id Int
  end_datetime    DateTime
  start_datetime  DateTime
  point_value     Int           @default(0)
  scored          Boolean       @default(false)
  status          ListingStatus @default(AcceptingApplications)
  applications    Application[]
  organization    Organization  @relation(fields: [organization_id], references: [id])
}

model Region {
  id     Int    @id @default(autoincrement())
  name   String
  points Int    @default(0)
  User   User[]
}

enum ApplicationStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum ListingStatus {
  AcceptingApplications
  ApplicationsClosed
  Completed
  Cancelled
}
