generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma_client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                   Int            @id @default(autoincrement())
  userId               String         @unique
  username             String         @unique
  email                String?        @unique
  profilePictureUrl    String?
  profilePictureFileId String?
  bio                  String?
  signupCompleted      Boolean        @default(false)
  ownerOf              Organization[] @relation("ownership")
  memberOf             Organization[] @relation("membership")
  application          Application[]
  region               Region?        @relation(fields: [regionId], references: [id])
  regionId             Int?
  follows              Follow[]
  interests            Subcategory[]
}

model Organization {
  id          Int       @id @default(autoincrement())
  name        String    @unique
  description String?
  ownerId     Int
  address     String?
  postcode    String?
  followers   Follow[] // <-- this is your addition
  listings    Listing[]
  owner       User      @relation("ownership", fields: [ownerId], references: [id])
  members     User[]    @relation("membership")
  Region      Region?   @relation(fields: [regionId], references: [id])
  regionId    Int?
}

model Follow {
  id             Int          @id @default(autoincrement())
  userId         Int
  organizationId Int
  organization   Organization @relation(fields: [organizationId], references: [id])
  user           User         @relation(fields: [userId], references: [id])

  @@unique([userId, organizationId])
}

model Application {
  id          Int               @id @default(autoincrement())
  description String?
  status      ApplicationStatus @default(PENDING)
  listing     Listing           @relation(fields: [listingId], references: [id])
  user        User              @relation(fields: [userId], references: [id])
  listingId   Int
  userId      Int
}

model Listing {
  id             Int           @id @default(autoincrement())
  name           String
  description    String?
  startDatetime  DateTime
  endDatetime    DateTime
  status         ListingStatus @default(acceptingApplications)
  pointValue     Int           @default(0)
  scored         Boolean       @default(false)
  organization   Organization  @relation(fields: [organizationId], references: [id])
  organizationId Int

  categorgies Subcategory[]

  applications Application[]
}

model Region {
  id     Int    @id @default(autoincrement())
  name   String @unique
  points Int    @default(0)

  users         User[]
  organizations Organization[]
}

enum ApplicationStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum ListingStatus {
  acceptingApplications
  applicationsClosed
  completed
  cancelled
}

model Category {
  id            Int           @id @default(autoincrement())
  name          String        @unique
  description   String?
  subcategories Subcategory[]
  listingId     Int?
}

model Subcategory {
  id                Int      @id @default(autoincrement())
  name              String   @unique
  description       String?
  primaryCategoryId Int
  primaryCategory   Category @relation(fields: [primaryCategoryId], references: [id])
  users             User[]
  Listing           Listing? @relation(fields: [listingId], references: [id])
  listingId         Int?
}
