generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma_client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id       Int     @id @default(autoincrement())
  user_id  String  @unique
  username String  @unique
  email    String? @unique
  bio      String?

  owner_of  Organization[] @relation("ownership")
  member_of Organization[] @relation("membership")

  application Application[]
}

model Organization {
  id          Int       @id @default(autoincrement())
  name        String    @unique
  description String?
  owner_id    Int
  address     String?
  postcode    String?
  listings    Listing[]
  owner       User      @relation("ownership", fields: [owner_id], references: [id])
  members     User[]    @relation("membership")
  followers Follow[]      // Relation
}

model Follow {
  id             Int           @id @default(autoincrement())
  user           User          @relation(fields: [userId], references: [id])
  userId         Int
  organization   Organization  @relation(fields: [organizationId], references: [id])
  organizationId Int

  @@unique([userId, organizationId]) // Ensure unique follows
}

enum ApplicationStatus {
  PENDING
  ACCEPTED
  REJECTED
}

model Application {
  id          Int               @id @default(autoincrement())
  description String?
  status      ApplicationStatus @default(PENDING)

  listing    Listing @relation(fields: [listing_id], references: [id])
  user       User    @relation(fields: [user_id], references: [id])
  listing_id Int     @map("listingId")
  user_id    Int     @map("userId")
}

model Listing {
  id             Int           @id @default(autoincrement())
  name           String
  description    String?
  start_datetime DateTime
  end_datetime   DateTime
  status         ListingStatus @default(AcceptingApplications)
  point_value    Int           @default(0)
  scored         Boolean       @default(false)

  organization    Organization @relation(fields: [organization_id], references: [id])
  organization_id Int

  applications Application[]
}

enum ListingStatus {
  AcceptingApplications
  ApplicationsClosed
  Completed
  Cancelled
}

model Region {
  id     Int    @id @default(autoincrement())
  name   String
  points Int    @default(0)

  users User[]
}
